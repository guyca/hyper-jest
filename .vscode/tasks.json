{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "yarn: watch",
      "type": "shell",
      "command": "yarn",
      "args": ["watch"],
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": { "regexp": "^✘ \\[ERROR\\] (.*) \\((.*):(\\d+)\\)$", "message": 1, "file": 2, "line": 3 },
        "background": { "activeOnStart": true, "beginsPattern": "\\[watch\\] build started", "endsPattern": "\\[watch\\] build finished" }
      },
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
